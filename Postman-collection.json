    {
      "name": "GET /api/pois/{key}/images — POI Images",
      "item": [
        {
          "name": "Images — castle (has 3 gallery images)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pois/castle/images",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pois", "castle", "images"]
            },
            "description": "castle has castle.webp + castle1.webp + castle2.webp + castle3.webp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has poiName and imageUrls', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('poiName').that.equals('castle');",
                  "    pm.expect(body).to.have.property('imageUrls').that.is.an('array');",
                  "});",
                  "pm.test('imageUrls is non-empty', () => {",
                  "    pm.expect(pm.response.json().imageUrls.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('Main image included', () => {",
                  "    pm.expect(pm.response.json().imageUrls).to.include('/images/castle.webp');",
                  "});",
                  "pm.test('Gallery images included (castle has 3)', () => {",
                  "    const urls = pm.response.json().imageUrls;",
                  "    pm.expect(urls).to.include('/images/castle1.webp');",
                  "    pm.expect(urls).to.include('/images/castle2.webp');",
                  "    pm.expect(urls).to.include('/images/castle3.webp');",
                  "});",
                  "pm.test('All URLs match pattern /images/{key}[n].webp', () => {",
                  "    pm.response.json().imageUrls.forEach(url => {",
                  "        pm.expect(url).to.match(/^\\/images\\/castle\\d*\\.webp$/);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
