{
  "info": {
    "name": "Visit Polzela — REST API",
    "_postman_id": "visit-polzela-rest-api-v1",
    "description": "Tests for the Quarkus REST endpoints of the Visit Polzela application.\n\nBase URL is stored in the collection variable `baseUrl` (default: http://localhost:8080).\nChange it once in the collection Variables tab to point at any environment.\n\nEndpoints covered:\n  GET /api/pois?lang={lang}\n  GET /api/pois/{key}?lang={lang}\n  GET /api/pois/{key}/images\n  GET /api/texts?lang={lang}&keys={keys}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Root URL of the running Quarkus server. Change to match your environment."
    }
  ],
  "item": [
    {
      "name": "GET /api/pois — All POIs",
      "item": [
        {
          "name": "All POIs — English (default)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pois?lang=EN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pois"],
              "query": [{ "key": "lang", "value": "EN" }]
            },
            "description": "Returns all POIs with localized displayName + shortDescription. No long description included."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON array', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "    pm.expect(body.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('Each POI has required fields', () => {",
                  "    const body = pm.response.json();",
                  "    body.forEach(poi => {",
                  "        pm.expect(poi).to.have.property('name').that.is.a('string');",
                  "        pm.expect(poi).to.have.property('displayName').that.is.a('string');",
                  "        pm.expect(poi).to.have.property('shortDescription').that.is.a('string');",
                  "        pm.expect(poi).to.have.property('imagePath').that.is.a('string');",
                  "        pm.expect(poi).to.have.property('order').that.is.a('number');",
                  "        pm.expect(poi).to.have.property('mapUrl').that.is.a('string');",
                  "        pm.expect(poi).to.have.property('navigationUrl').that.is.a('string');",
                  "        pm.expect(poi).to.have.property('appleNavigationUrl').that.is.a('string');",
                  "    });",
                  "});",
                  "pm.test('POIs are ordered by order field', () => {",
                  "    const body = pm.response.json();",
                  "    for (let i = 1; i < body.length; i++) {",
                  "        pm.expect(body[i].order).to.be.at.least(body[i-1].order);",
                  "    }",
                  "});",
                  "pm.test('imagePath starts with /images/', () => {",
                  "    const body = pm.response.json();",
                  "    body.forEach(poi => {",
                  "        pm.expect(poi.imagePath).to.match(/^\\/images\\/.+\\.webp$/);",
                  "    });",
                  "});",
                  "pm.test('Castle POI is present', () => {",
                  "    const body = pm.response.json();",
                  "    const castle = body.find(p => p.name === 'castle');",
                  "    pm.expect(castle).to.not.be.undefined;",
                  "    pm.expect(castle.displayName).to.include('Castle');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
