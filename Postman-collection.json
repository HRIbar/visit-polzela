        {
          "name": "Images — all 17 known POIs (smoke check)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pois/castle/images",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pois", "castle", "images"]
            },
            "description": "Quick smoke check — runs a pre-request script that iterates all keys and logs the count. Individual assertions live in the dedicated per-key requests above."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// All POI keys from pois.txt — useful for manual iteration via Collection Runner",
                  "const allKeys = [",
                  "    'castle','park','icecream','fortesa','mountoljka','maurerhouse',",
