          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All POI names are unique', () => {",
                  "    const names = pm.response.json().map(p => p.name);",
                  "    const unique = new Set(names);",
                  "    pm.expect(unique.size).to.equal(names.length);",
                  "});",
                  "pm.test('All orders are >= 0', () => {",
                  "    pm.response.json().forEach(p => pm.expect(p.order).to.be.at.least(0));",
                  "});",
                  "pm.test('No description in list response', () => {",
                  "    pm.response.json().forEach(p => {",
                  "        pm.expect(p.description).to.equal('');",
                  "    });",
                  "});",
                  "// Store names for possible follow-up",
                  "const names = pm.response.json().map(p => p.name);",
                  "pm.variables.set('poiNamesFromList', JSON.stringify(names));"
                ],
                "type": "text/javascript"
              }
            }
